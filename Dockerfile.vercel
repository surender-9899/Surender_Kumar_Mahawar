# Use Node 22 (required by @tanstack/react-start)
FROM node:22-alpine

WORKDIR /app

# Copy package manifest
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy full project source
COPY . .

# Build the application
RUN npm run build

# Default PORT environment variable
ENV PORT=80

EXPOSE 80

# Start server listening on 0.0.0.0 and Vercel's dynamic $PORT
CMD ["sh", "-c", "npx vite preview --host 0.0.0.0 --port ${PORT:-80}"]
